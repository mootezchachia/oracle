# Copy to .env and fill in. docker-compose reads this file automatically.
# Never commit the real .env — these are credentials.

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord ----------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# --- TradingView inbound webhook -------------------------------------------
# Any shared string. Required in the alert JSON body as {"secret": "..."}.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Trading parameters -----------------------------------------------------
# Raise MIN_CONFIDENCE for fewer, higher-conviction alerts. 90 is the floor the
# model is calibrated against; below ~85 the alert quality falls off sharply.
MIN_CONFIDENCE=90
ACCOUNT_BALANCE=10000
MAX_RISK_PERCENT=1.0
